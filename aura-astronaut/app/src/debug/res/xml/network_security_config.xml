<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: unencrypted HTTP to the local Manager (npm run dev, port 3000).
  localhost = Mac over USB with `adb reverse tcp:3000 tcp:3000`; 10.0.2.2 = Mac from the emulator;
  172.16.41.32 = the Mac's LAN IP on 2026-11-14 (change it if it changes).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">172.16.41.32</domain>
    </domain-config>
</network-security-config>
